[node name="Npc2" parent="NPCs" node_paths=PackedStringArray("player") instance=ExtResource("125_s8ho8")]
position = Vector2(-3051, -1616)
player = NodePath("../../Player")
bunny_type = ExtResource("127_rayc1")
soundbite = ExtResource("16_kpr7j")
dialogue_0 = ["Does the city really need an expansion?", "How to get up there..."]
dialogue_1 = ["I'd have to be frictionless or something, then  I could just slide UP the wall."]
box_y = 10
box_x = 120
prompt_y = 10
prompt_x = 40

[node name="Npc3" parent="NPCs" node_paths=PackedStringArray("player") instance=ExtResource("125_s8ho8")]
position = Vector2(1170, -1224)
player = NodePath("../../Player")
bunny_type = ExtResource("128_b5665")
dialogue_0 = ["Are you enjoying yourself, little bunny?", "It's like you could spend your whole life in here."]
dialogue_1 = ["If only you didn't have someone waiting on you, that is."]

[node name="Npc4" parent="NPCs" node_paths=PackedStringArray("player") instance=ExtResource("125_s8ho8")]
position = Vector2(-1167, -1856)
player = NodePath("../../Player")
bunny_type = ExtResource("131_oyuen")
soundbite = ExtResource("132_jutr0")
dialogue_0 = ["Good lord, as if getting up here wasn't bad enough...", "Come on, pick up."]
dialogue_1 = ["Hello? Yeah, hi, I'm up here.", "How am I supposed to even make it to the other side?", "I don't think I can with the tools I got, I might have to go back down and get the rest, man.", "...What? No! I'm not crossing that! I will get shocked, you LUNATIC!", "...Fine, I'll wait here."]
dialogue_2 = ["If only I had the rest I'd be able to cross just fine.", "Yeah, I know you're coming, just saying."]
box_y = 10
prompt_y = 10

[node name="Npc5" parent="NPCs" node_paths=PackedStringArray("player") instance=ExtResource("125_s8ho8")]
position = Vector2(2692, -1408)
player = NodePath("../../Player")
bunny_type = ExtResource("133_0atnk")
facing_direction = "Right"
soundbite = ExtResource("134_s135o")
dialogue_0 = ["Oh, boy, I just need to lay down real quick...", "Huh? What's that up there?"]
dialogue_1 = ["Hey, you there, could you go check what's that up there?", "I don't see anything to stand on though... I guess I'm asking the impossible."]
dialogue_2 = ["Just... Just wake me up if you manage to get up... okay?"]
dialogue_3 = ["check_for_wand"]

[node name="Npc6" parent="NPCs" node_paths=PackedStringArray("player") instance=ExtResource("125_s8ho8")]
position = Vector2(899, -2464)
player = NodePath("../../Player")
bunny_type = ExtResource("135_6eeu5")
soundbite = ExtResource("20_eyl8m")
dialogue_0 = ["Pshhh, wavedashing? That has to be the easiest thing I've done here.", "There's no frame data in this screen either!"]
dialogue_1 = ["You get me, right? I saw you on your way up here.", "You kept running around as if you couldn't turn to the sides.", "I've done some crazy stuff, but you're on another level."]
dialogue_2 = ["Though I suppose practicing wouldn't be bad, right?"]

[node name="Npc7" parent="NPCs" node_paths=PackedStringArray("player") instance=ExtResource("125_s8ho8")]
position = Vector2(-365, -2424)
player = NodePath("../../Player")
bunny_type = ExtResource("136_1vasd")
soundbite = ExtResource("17_jhwf2")
dialogue_0 = ["On a path of redemption, little one?", "Ah, where are my manners? My name is Dapperdove. Pleased to meet you.", "You all stick out like sore thumbs I must say. No, not the lovely folk here.", "I mean you Seekers, with the lackluster visage."]
dialogue_1 = ["You can't fly through life at the same speed, little one.", "Though let's face it, that never got you on time, anyways."]
box_y = 10
prompt_y = 10

[node name="Npc8" parent="NPCs" node_paths=PackedStringArray("player") instance=ExtResource("125_s8ho8")]
position = Vector2(590, -1504)
player = NodePath("../../Player")
bunny_type = ExtResource("137_wuwri")
facing_direction = "Right"
soundbite = ExtResource("16_kpr7j")
dialogue_0 = ["This must be a sick joke. OF course I expected some difficulties.", "But all these doors and pathways are bunny sized! I can barely fit!"]
dialogue_1 = [" Those platforms there look so spacious too...", "...At least the wife's having fun on the other side..."]
box_y = 14
prompt_y = 14

